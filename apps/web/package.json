    "@next/eslint-plugin-next": "15.5.25",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.70.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.28"
  }
