# All core features work with no API key and no paid service.
# Next.js server -> FastAPI. Never prefix this with NEXT_PUBLIC_.
# For separate native launches, copy to apps/web/.env.local.
# The local launcher and Docker Compose supply this URL automatically.
FRP_API_URL=http://127.0.0.1:8000
# Optional operator overrides; environment variables, not automatically loaded by Python.
# FRP_DATA_DIR=data/cache
# FRP_SNAPSHOT=data/sample/analysis.json
FRP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_TELEMETRY_DISABLED=1
# Optional comma-separated hostnames for a development proxy, never a public deployment.
# FRP_DEV_ORIGINS=
# Docker Compose exposes only the frontend on loopback by default.
FRP_BIND_ADDRESS=127.0.0.1
FRP_WEB_PORT=3000
